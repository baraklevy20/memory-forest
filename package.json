{
  "name": "memory-forest",
  "private": true,
  "description": "Memory Forest - a passive forest that grows from your study history",
  "license": "MIT",
  "scripts": {
    "build": "python3 dev/package.py",
    "test": "python3 -m unittest discover -s tests && npm run test:js && python3 e2e/phone_check.py --if-changed && python3 e2e/heatmap_check.py --if-changed && python3 e2e/page_check.py --if-changed && python3 e2e/onigiri_check.py --if-changed && python3 e2e/layout_check.py --if-changed && python3 e2e/scenery_check.py --quick --if-changed",
    "test:phone": "python3 e2e/phone_check.py",
    "test:heatmap": "python3 e2e/heatmap_check.py",
    "test:js": "node --test tests/js/*.test.mjs",
    "test:page": "python3 e2e/page_check.py",
    "test:onigiri": "python3 e2e/onigiri_check.py",
    "test:layout": "python3 e2e/layout_check.py",
    "test:scenery": "python3 e2e/scenery_check.py",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint web dev e2e tests/js",
    "lint:py": "python3 -m ruff check .",
    "check": "npm run lint && npm run test && npm run render",
    "check:anki": "python3 e2e/old_anki.py --check --all",
    "render": "python3 e2e/render_check.py smoke",
    "render:quick": "python3 e2e/render_check.py smoke --quick",
    "baseline": "python3 e2e/render_check.py baseline",
    "compare": "python3 e2e/render_check.py compare",
    "compare:quick": "python3 e2e/render_check.py compare --quick",
    "perf": "node dev/perf_check.mjs compare",
    "perf:baseline": "node dev/perf_check.mjs baseline",
    "audit": "python3 dev/combo_audit.py",
    "gallery": "python3 dev/build_gallery.py",
    "gif": "python3 dev/make_gif.py",
    "payload": "python3 dev/export_payload.py",
    "goats": "python3 dev/goats.py",
    "notes": "python3 dev/notes.py",
    "thumbs": "python3 dev/thumbnails.py",
    "nature-gifs": "python3 dev/nature_gifs.py",
    "heatmap-keys": "python3 dev/heatmap_keys.py",
    "docs-pictures": "python3 dev/docs_pictures.py",
    "docs-grids": "python3 dev/docs_grids.py",
    "strings": "python3 dev/strings.py"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "puppeteer-core": "^24.43.1"
  }
}
